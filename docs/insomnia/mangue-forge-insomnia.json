      "parentId": "fld_partidas",
      "modified": 1752278400000,
      "created": 1752278400000,
      "url": "{{ _.baseUrl }}/api/partidas/COLE_O_PARTIDA_ID_AQUI/ataques",
      "name": "Processar Ataque",
      "description": "Processa um ataque do combatente da vez contra um alvo. Substitua 'COLE_O_PARTIDA_ID_AQUI' na URL pelo partidaId retornado ao criar a partida, e 'COLE_O_ALVO_ID_AQUI' no corpo pelo id de um combatente que NÃO seja o combatenteDaVezId (você não pode atacar quem já está agindo). 'nomeDaAcao' deve ser uma chave presente nos atributos do atacante (ex.: 'forca' para D20, 'mira' para Percentual).",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"alvoId\": \"COLE_O_ALVO_ID_AQUI\",\n  \"nomeDaAcao\": \"forca\"\n}"
