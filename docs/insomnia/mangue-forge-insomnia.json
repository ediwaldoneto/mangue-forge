      "_id": "req_criar_partida_d20",
      "parentId": "fld_partidas",
      "modified": 1752278400000,
      "created": 1752278400000,
      "url": "{{ _.baseUrl }}/api/partidas",
      "name": "Criar Partida (motor D20)",
      "description": "Cria uma partida com 2 combatentes usando o motor D20 (rola 1d20 + atributo vs. dificuldade). A resposta traz partidaId, o id de cada combatente e quem começa o turno — copie esses ids para usar na requisição 'Processar Ataque'.",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"motor\": \"d20\",\n  \"dificuldade\": 12,\n  \"chaveIniciativa\": \"agilidade\",\n  \"combatentes\": [\n    {\"identificacao\": \"Heroi\", \"time\": \"herois\", \"atributos\": {\"forca\": 5, \"agilidade\": 9}, \"hpMaximo\": 20},\n    {\"identificacao\": \"Monstro\", \"time\": \"monstros\", \"atributos\": {\"forca\": 3, \"agilidade\": 4}, \"hpMaximo\": 15}\n  ]\n}"
      },
      "parameters": [],
      "headers": [
        {"name": "Content-Type", "value": "application/json"}
      ],
      "authentication": {},
      "metaSortKey": -1752278400000,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global",
      "_type": "request"
    },
    {
      "_id": "req_criar_partida_percentual",
      "parentId": "fld_partidas",
      "modified": 1752278400000,
      "created": 1752278400000,
      "url": "{{ _.baseUrl }}/api/partidas",
      "name": "Criar Partida (motor Percentual)",
      "description": "Mesma criação de partida, mas usando o motor Percentual (rola 1d100 contra uma perícia). 'dificuldade' é ignorada para esse motor.",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"motor\": \"percentual\",\n  \"chaveIniciativa\": \"agilidade\",\n  \"combatentes\": [\n    {\"identificacao\": \"Heroi\", \"time\": \"herois\", \"atributos\": {\"mira\": 60, \"agilidade\": 9}, \"hpMaximo\": 20},\n    {\"identificacao\": \"Monstro\", \"time\": \"monstros\", \"atributos\": {\"mira\": 40, \"agilidade\": 4}, \"hpMaximo\": 15}\n  ]\n}"
      },
      "parameters": [],
